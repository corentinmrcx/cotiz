# ------------------------------------------------------------------
# CoTiz — configuration locale
# Copier ce fichier en `.env` puis lancer `docker compose up -d`.
# Le `.env` n'est jamais commité.
# ------------------------------------------------------------------

APP_NAME=CoTiz
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=fr

# Clé de chiffrement Laravel. Laisser vide : elle est générée au premier
# démarrage et conservée dans ./data/app.key (sauvegardée avec les données).
APP_KEY=

# Authentification (décision D4). Inutile en local, à passer à true le jour
# d'une mise en ligne. Le compte est créé au démarrage depuis les deux
# variables suivantes.
APP_AUTH_ENABLED=false
APP_AUTH_EMAIL=bureau@example.org
APP_AUTH_PASSWORD=A_CHANGER

# Paramètres SMTP initiaux. Ils sont copiés dans les Réglages au premier
# démarrage puis modifiables depuis l'écran Réglages (stockés chiffrés).
# MAIL_PASSWORD = mot de passe d'application Gmail de l'association.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@exemple.org
MAIL_PASSWORD=A_CHANGER
MAIL_FROM_ADDRESS=contact@exemple.org
MAIL_FROM_NAME="Foyer de Soudron"

# Journalisation
LOG_CHANNEL=single
LOG_LEVEL=warning
